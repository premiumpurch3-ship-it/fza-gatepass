limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
server_tokens off;

server {                                   # HTTP: ACME challenge + redirect
  listen 80;
  server_name ${DOMAIN} files.${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {                                   # web + API
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  include /etc/nginx/snippets/security-headers.conf;
  client_max_body_size 10m;                # files go straight to object storage; the API only receives JSON

  location = /api/v1/auth/login { limit_req zone=login burst=5 nodelay; proxy_pass http://api:8000; include /etc/nginx/snippets/proxy.conf; }
  location /api/ { limit_req zone=api burst=40 nodelay; proxy_pass http://api:8000; include /etc/nginx/snippets/proxy.conf; }
  location /health { proxy_pass http://api:8000; }
  location / { proxy_pass http://web:3000; include /etc/nginx/snippets/proxy.conf; }
}

server {                                   # object storage (presigned URLs signed for https://files.DOMAIN)
  listen 443 ssl;
  http2 on;
  server_name files.${DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  include /etc/nginx/snippets/security-headers.conf;
  client_max_body_size 600m;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_read_timeout 600s;
  proxy_send_timeout 600s;
  location / {
    proxy_pass http://minio:9000;
    proxy_set_header Host $http_host;      # preserve the signed host
    include /etc/nginx/snippets/proxy.conf;
  }
}
